{
  "expo": {
    "name": "Entole",
    "slug": "entole",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "entole",
    "userInterfaceStyle": "light",
    "backgroundColor": "#FBF9F5",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "to.entole.app",
      "associatedDomains": ["webcredentials:entole.to"]
    },
    "android": {
      "package": "to.entole.app",
      "adaptiveIcon": {
        "backgroundColor": "#FBF9F5",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Entole uses Face ID to confirm it is you before money moves."
        }
      ],
      "expo-splash-screen"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "entole": {
        "contractAddress": "0xd0c1099827e49C07f264927d0Dd3416eb29EA9b7",
        "tokenAddress": "0xaca20A081Ab69148E291e65dcf4f69Ef9B0674A6",
        "growthVaultAddress": "",
        "rpcUrl": "https://testnet-rpc.monad.xyz",
        "chainId": 10143,
        "indexerUrl": ""
      }
    }
  }
}
