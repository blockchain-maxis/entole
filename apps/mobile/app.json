{
  "expo": {
    "name": "Entole",
    "slug": "entole",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "entole",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#FBF9F5",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "to.entole.app",
      "associatedDomains": [
        "webcredentials:entole.to"
      ]
    },
    "android": {
      "package": "to.entole.app",
      "adaptiveIcon": {
        "backgroundColor": "#FBF9F5",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Entole uses Face ID to confirm it is you before money moves."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Entole uses the camera to scan a payment code."
        }
      ],
      "expo-document-picker",
      "expo-splash-screen"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "entole": {
        "contractAddress": "0xd0c1099827e49C07f264927d0Dd3416eb29EA9b7",
        "apiBase": "https://entole.vercel.app",
        "routerAddress": "0x26dfd3aa7601B57d8b7BB9e9555f5Bdac60dAB01",
        "tokenAddress": "0xa9012a055bd4e0eDfF8Ce09f960291C09D5322dC",
        "growthVaultAddress": "0x9D904c6a9231F16913ad3A41563dCB07bF9d89bd",
        "rpcUrl": "https://testnet-rpc.monad.xyz",
        "chainId": 10143,
        "indexerUrl": "",
        "billPaymentApiBase": "",
        "billPaymentProxyToken": "",
        "billItemCodes": {}
      },
      "router": {},
      "eas": {
        "projectId": "88907d7e-f009-48b0-9a79-fc127507abbc"
      }
    },
    "owner": "phoenixwolf"
  }
}
