# Copy to .env.local (gitignored) and fill in. Never put secrets in `.env`,
# which is tracked. Everything NEXT_PUBLIC_ is shipped to the browser.
# Full key-by-key notes: docs/ENV.md

# --- Public deployment config (safe to ship) ---------------------------------
NEXT_PUBLIC_ENTOLE_POLICY_ADDRESS=
NEXT_PUBLIC_ENTOLE_ROUTER_ADDRESS=
NEXT_PUBLIC_ENTOLE_TOKEN_ADDRESS=
NEXT_PUBLIC_ENTOLE_GROWTH_VAULT_ADDRESS=
# The account bill payments are made to (public; never shown on a screen).
NEXT_PUBLIC_ENTOLE_BILLS_ADDRESS=
NEXT_PUBLIC_RPC_URL=
NEXT_PUBLIC_CHAIN_ID=
NEXT_PUBLIC_RP_ID=
NEXT_PUBLIC_INDEXER_URL=
NEXT_PUBLIC_ONRAMP_URL_TEMPLATE=

# --- Server only: sponsor / relay -------------------------------------------
# Funded key that pays network fees for relayed sends and top-ups.
SPONSOR_PRIVATE_KEY=
RELAY_MAX_AMOUNT=

# --- Adding real money (main network only: NEXT_PUBLIC_CHAIN_ID=143) ---------
# From another app (scan code) and card need nothing here.
# Optional. Relay answers without a key, at a lower rate limit.
RELAY_API_KEY=
# Bank transfer in naira stays "coming soon" until all three below are set.
# Our own Onramp.money app id. Their public id (1) does not work: its page
# ignores the address passed in.
ONRAMP_MONEY_APP_ID=
# An account of ours: a bank-transfer conversion that fails is returned here.
ONRAMP_REFUND_ADDRESS=
# Shows the bank-transfer option in the app. Set to "on" with the two above.
NEXT_PUBLIC_BANK_TRANSFER=
# Optional. Where the partner sends people back to; defaults to this deployment.
ONRAMP_RETURN_ORIGIN=

# --- Server only: durable store (required in production) --------------------
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Server only: Telegram intake -------------------------------------------
TELEGRAM_BOT_TOKEN=
# Random string; also passed to Telegram's setWebhook as secret_token.
TELEGRAM_WEBHOOK_SECRET=
QWEN_API_KEY=

# --- Server only: integrations (each stays gated off while empty) -----------
AGORA_ACCESS_KEY=
AURORA_INTENTS_API_KEY=
# Aurora's endpoint is best-effort until checked with a live key; fix it here, not in code.
AURORA_INTENTS_API_BASE=
AURORA_INTENTS_DEPOSIT_PATH=
NANSEN_API_KEY=
# Same for Nansen.
NANSEN_API_BASE=
NANSEN_NETFLOW_PATH=
CHAINLINK_CRE_WEBHOOK_SECRET=
# Pay a bill (Flutterwave). Held only by /api/bills/*; paid only after the
# person's own payment to the bills account has settled.
BILL_PAYMENT_API_KEY=
BILL_PAYMENT_API_BASE=
# JSON, e.g. {"electricity":"<item code>","airtime-data":"<item code>"}
BILL_ITEM_CODES=
# Endpoint paths, if Flutterwave's differ from the defaults.
BILL_VALIDATE_PATH=
BILL_PAY_PATH=

# --- Indexer ----------------------------------------------------------------
ENVIO_API_TOKEN=
