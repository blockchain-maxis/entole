# Public testnet deployment config — not secrets. See contracts/README.md.
# Not yet consumed anywhere (web has no sign-in flow to build a real gateway
# from until Phase 4's auth build-out); committed now so the values exist in
# one place both apps can point at.
NEXT_PUBLIC_ENTOLE_POLICY_ADDRESS=0xd0c1099827e49C07f264927d0Dd3416eb29EA9b7
NEXT_PUBLIC_ENTOLE_TOKEN_ADDRESS=0xaca20A081Ab69148E291e65dcf4f69Ef9B0674A6
# Empty until GrowthVault is deployed — see contracts/README.md's Status section.
NEXT_PUBLIC_ENTOLE_GROWTH_VAULT_ADDRESS=
NEXT_PUBLIC_RPC_URL=https://testnet-rpc.monad.xyz
NEXT_PUBLIC_CHAIN_ID=10143
# Envio HyperIndex GraphQL endpoint, once `indexer/` is actually running —
# see indexer/README.md ("To finish": needs ENVIO_API_TOKEN). Empty means
# the app keeps reading activity from the off-chain snapshot, same as today.
NEXT_PUBLIC_INDEXER_URL=

# Real secrets below — deliberately NOT prefixed NEXT_PUBLIC_, so Next.js
# never ships them to the browser bundle. Both `packages/core/settlement-
# asset.ts` (Agora AUSD) and `packages/core/aurora-intents.ts` (any-chain
# funding) are plain modules with no client/server assumption baked in —
# call them only from a server context (an API route, same pattern as
# `app/api/telegram/webhook/route.ts`), never from `apps/mobile` or a
# client component, since a mobile app bundle can't hold a secret safely.
# Empty means both stay in their documented "not configured" gated-off
# state — see each file's own header comment for what's confirmed vs
# best-effort about the API shape.
AGORA_ACCESS_KEY=
AURORA_INTENTS_API_KEY=
# Qwen (DashScope) key for `packages/core/telegram-intake.ts`'s assistant
# parsing layer — same server-only rule. Empty keeps parsing on the
# deterministic heuristic alone.
QWEN_API_KEY=
# Shared secret a real Chainlink CRE workflow sends in the
# `x-cre-webhook-secret` header when it POSTs to
# app/api/chainlink-cre/release/route.ts. Empty keeps that route at 501 —
# see its header comment and packages/core/chainlink-cre.ts.
CHAINLINK_CRE_WEBHOOK_SECRET=

# "Pay a bill" (packages/core/bill-payment.ts). These ARE prefixed
# NEXT_PUBLIC_, so they reach the browser: point the base URL at your own
# server proxy and put a proxy-scoped token here — never the aggregator's
# own secret key. Empty keeps Pay a bill in its "not available yet" state.
# NEXT_PUBLIC_BILL_ITEM_CODES is JSON, e.g. {"electricity":"<item code>"}.
NEXT_PUBLIC_BILL_PAYMENT_API_BASE=
NEXT_PUBLIC_BILL_PAYMENT_PROXY_TOKEN=
NEXT_PUBLIC_BILL_ITEM_CODES=
