# Public test network deployment config: not secrets. See contracts/README.md.
# The web app builds its gateway from these (apps/web/lib/onchain.ts) and the
# server routes read the same ones; the phone app carries the same values in
# apps/mobile/app.json. This file is tracked, so nothing secret goes in it.
NEXT_PUBLIC_ENTOLE_POLICY_ADDRESS=0xEE9C2cE4FC3a58f88D3E2FCE9807cDcA3A97Ed3e
NEXT_PUBLIC_ENTOLE_ROUTER_ADDRESS=0x26dfd3aa7601B57d8b7BB9e9555f5Bdac60dAB01
NEXT_PUBLIC_ENTOLE_TOKEN_ADDRESS=0xa9012a055bd4e0eDfF8Ce09f960291C09D5322dC
# Where savings are kept on the test network: see contracts/README.md's
# Status section. Empty, the savings screens say savings are not available.
NEXT_PUBLIC_ENTOLE_GROWTH_VAULT_ADDRESS=0x9D904c6a9231F16913ad3A41563dCB07bF9d89bd
NEXT_PUBLIC_RPC_URL=https://testnet-rpc.monad.xyz
NEXT_PUBLIC_CHAIN_ID=10143
# The passkey domain. It has to be the host the app is served from, and the
# same value the phone app uses (EXPO_PUBLIC_RP_ID), or the two derive
# different accounts. Local development overrides it in .env.local.
NEXT_PUBLIC_RP_ID=entole.pro
# Envio HyperIndex GraphQL endpoint: the hosted deployment of `indexer/`, see
# indexer/README.md ("Deploying it"). Each deployment has its own address, so
# this changes when the `envio` branch moves. Empty means activity is only
# what the device and the server already know.
NEXT_PUBLIC_INDEXER_URL=https://indexer.dev.hyperindex.xyz/ab2b91f/v1/graphql

# The names below are for real secrets and are left empty here on purpose:
# the values live in .env.local and in the host's settings, never in this
# file. They are deliberately NOT prefixed NEXT_PUBLIC_, so Next.js never
# ships them to the browser, and they are read only in server code (an API
# route), never from apps/mobile or a client component. Empty, each feature
# stays in its "not configured" state and its route answers 501. Every name
# the server reads, and what it turns on, is listed in docs/ENV.md.
AGORA_ACCESS_KEY=
AURORA_INTENTS_API_KEY=
# Qwen (DashScope) key for `packages/core/telegram-intake.ts`'s assistant
# parsing layer — same server-only rule. Empty keeps parsing on the
# deterministic heuristic alone.
QWEN_API_KEY=
# Shared secret a real Chainlink CRE workflow sends in the
# `x-cre-webhook-secret` header when it POSTs to
# app/api/chainlink-cre/release/route.ts. Empty keeps that route at 501 —
# see its header comment and packages/core/chainlink-cre.ts.
CHAINLINK_CRE_WEBHOOK_SECRET=

# "Pay a bill" has no public settings. The biller is called from the server
# only (apps/web/lib/server/bills.ts), with BILL_PAYMENT_API_KEY and
# BILL_ITEM_CODES: see docs/ENV.md. Nothing about it may be NEXT_PUBLIC_.
